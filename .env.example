# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored - it never leaves your machine.

# Optional: real web search via Tavily (Job Scout tool).
# Get a key at https://app.tavily.com  (free tier: 1000 credits/month)
# ORCHESTRA_TAVILY_API_KEY=your-key-here

# Optional: override the default local models.
# ORCHESTRA_MAIN_MODEL=qwen2.5:7b
# ORCHESTRA_FAST_MODEL=qwen2.5:7b

# Optional: tuning (defaults shown). See README "Configuration".
# ORCHESTRA_NUM_CTX=8192
# ORCHESTRA_KEEP_ALIVE=30m
# ORCHESTRA_REQUEST_TIMEOUT_S=120
# ORCHESTRA_WARM_ON_START=true
# ORCHESTRA_MAX_CONCURRENT_RUNS=2
# ORCHESTRA_MAX_MESSAGE_CHARS=8000
# ORCHESTRA_PLANNER_FAST_PATH=true
# ORCHESTRA_ALLOW_PRIVATE_FETCH=false

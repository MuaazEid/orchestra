# Normalize line endings so a Windows checkout and a Linux checkout produce
# identical diffs (and Git stops printing "LF will be replaced by CRLF").
* text=auto eol=lf
# Windows scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
# Binary assets
*.ico binary
*.png binary
*.jpg binary
